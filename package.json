{
  "name": "noryth",
  "version": "0.1.0",
  "private": true,
  "description": "Noryth - 本地优先的多 Agent 小说创作工作台",
  "author": "Noryth",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:slice": "node scripts/dev-slice.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:e2e": "playwright test",
    "gen:layout": "python docs/scripts/check_ui_spec.py --emit-json > layout.tmp.json && node scripts/gen-layout.mjs layout.tmp.json",
    "prepare:native": "node scripts/prepare-native.mjs",
    "postinstall": "node scripts/prepare-native.mjs",
    "gen:tools": "node scripts/gen-tools.mjs",
    "gen:check": "node scripts/gen-check.mjs",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "better-sqlite3": "13.1.1",
    "kysely": "^0.29.9",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sqlite-vec": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "4.3.2",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.7.2",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
