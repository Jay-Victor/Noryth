{
  "name": "consistency.check",
  "version": "1.0.0",
  "family": "verify",
  "summary": "对 revision 做确定性检查：引用缺失、时间轴、单值槽、出口状态与泄漏候选",
  "actors": [
    "reviewer"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [],
  "limits": {
    "timeout_ms": 2000,
    "max_result_tokens": 3000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "revision_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "required": [
      "revision_id"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "revision_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "issue_count": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "issues": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "error",
                "warn",
                "candidate"
              ]
            },
            "message": {
              "type": "string"
            },
            "beat_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "ref_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "code",
            "severity",
            "message",
            "beat_id",
            "ref_id"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "revision_id",
      "issue_count",
      "issues"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M0",
  "m0": true,
  "tool_id": "T24"
}
