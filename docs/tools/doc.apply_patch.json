{
  "name": "doc.apply_patch",
  "version": "1.0.0",
  "family": "propose",
  "summary": "G5 决策后逐条落盘 patch，生成新 revision",
  "actors": [],
  "side_effect": "commit",
  "agent_callable": false,
  "requires_gate": "G5",
  "idempotency": "key_required",
  "injected": [],
  "limits": {
    "timeout_ms": 5000,
    "max_result_tokens": 2000,
    "max_calls_per_turn": 1
  },
  "degrade": [
    "full",
    "summary",
    "fail"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "proposal_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "decisions": {
        "minItems": 1,
        "maxItems": 50,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "patch_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "decision": {
              "type": "string",
              "enum": [
                "accept",
                "reject"
              ]
            }
          },
          "required": [
            "patch_id",
            "decision"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "proposal_id",
      "decisions"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "revision_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "applied_count": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "revision_id",
      "applied_count"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M0",
  "m0": true,
  "tool_id": "S02",
  "system": true
}
