{
  "name": "exit_dsl.validate",
  "version": "1.0.0",
  "family": "verify",
  "summary": "校验出口 DSL 是否合法且可判定；自然语言出口直接拒绝",
  "actors": [
    "orchestrator"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [],
  "limits": {
    "timeout_ms": 2000,
    "max_result_tokens": 3000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "expr": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "required": [
      "expr"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean"
      },
      "machine_decidable": {
        "type": "boolean"
      },
      "reasons": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "valid",
      "machine_decidable",
      "reasons"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M0",
  "m0": true,
  "tool_id": "T28"
}
