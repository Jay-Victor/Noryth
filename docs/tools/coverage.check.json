    "type": "object",
    "properties": {
      "gaps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "gaps"
    ],
    "additionalProperties": false
