{
  "name": "coverage.check",
  "version": "1.1.0",
  "family": "verify",
  "summary": "检查卷纲关键事件落点、主要角色出场、主线推进间隔与章纲 POV，输出可定位的 gaps",
  "actors": [
    "planner"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [],
  "limits": {
    "timeout_ms": 2000,
    "max_result_tokens": 3000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "enum": [
          "volume",
          "chapter",
          "project"
        ]
      }
    },
    "required": [
      "scope"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "enum": [
          "volume",
          "chapter",
          "project"
        ]
      },
      "error_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "warn_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "gaps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "key_event_unlanded",
                "character_uncast",
                "mainline_gap",
                "pov_missing",
                "meta_unannotated"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "error",
                "warn"
              ]
            },
            "node_id": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "severity",
            "node_id",
            "message"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "scope",
      "error_count",
      "warn_count",
      "gaps"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "P1",
  "m0": false,
  "tool_id": "T26"
}
