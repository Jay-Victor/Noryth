{
  "name": "voice.metrics",
  "version": "1.1.0",
  "family": "verify",
  "summary": "统计句长、口头禅、问句与第一人称，输出逐角色与两两区分度（M2）；只出指标，不自动判 fail",
  "actors": [
    "reviewer"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [],
  "limits": {
    "timeout_ms": 2000,
    "max_result_tokens": 3000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scene_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "required": [
      "scene_id"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sentence_length_jsd": {
        "type": "number"
      },
      "catchphrase_rate": {
        "type": "number"
      },
      "question_rate": {
        "type": "number"
      },
      "pairwise_distinctness": {
        "type": "number"
      },
      "characters": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "characterId": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            },
            "beatCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sentenceCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "avgSentenceLength": {
              "type": "number",
              "minimum": 0
            },
            "histogram": {
              "minItems": 6,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "catchphraseRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "questionRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "firstPersonRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "catchphrases": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "characterId",
            "name",
            "beatCount",
            "sentenceCount",
            "avgSentenceLength",
            "histogram",
            "catchphraseRate",
            "questionRate",
            "firstPersonRate",
            "catchphrases"
          ],
          "additionalProperties": false
        }
      },
      "pairs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "a": {
              "type": "string",
              "minLength": 1
            },
            "b": {
              "type": "string",
              "minLength": 1
            },
            "aName": {
              "type": "string"
            },
            "bName": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sentenceLengthJsd": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "catchphraseDelta": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "questionDelta": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "firstPersonDelta": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "a",
            "b",
            "aName",
            "bName",
            "score",
            "sentenceLengthJsd",
            "catchphraseDelta",
            "questionDelta",
            "firstPersonDelta"
          ],
          "additionalProperties": false
        }
      },
      "threshold": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "distinctnessMin": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "version",
          "distinctnessMin"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "sentence_length_jsd",
      "catchphrase_rate",
      "question_rate",
      "pairwise_distinctness",
      "characters",
      "pairs",
      "threshold"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M2",
  "m0": false,
  "tool_id": "T25"
}
