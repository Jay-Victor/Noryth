{
  "name": "character.get_own_card",
  "version": "1.0.0",
  "family": "structure",
  "summary": "返回本人完整角色卡与卡版本；角色身份由运行时注入，无可传参数",
  "actors": [
    "character"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [
    "character_id"
  ],
  "limits": {
    "timeout_ms": 800,
    "max_result_tokens": 2000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary",
    "empty"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "character_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "name": {
        "type": "string"
      },
      "card_version": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "card": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "required": [
      "character_id",
      "name",
      "card_version",
      "card"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M0",
  "m0": true,
  "tool_id": "T04"
}
