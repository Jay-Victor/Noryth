{
  "name": "manuscript.search_final",
  "version": "1.0.0",
  "family": "knowledge",
  "summary": "检索定稿正文，返回章、拍与引用；初稿不进入检索",
  "actors": [
    "orchestrator",
    "reviewer",
    "memory"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [],
  "limits": {
    "timeout_ms": 800,
    "max_result_tokens": 2000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary",
    "facts_only",
    "empty"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "limit": {
        "default": 5,
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      },
      "chapter_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "required": [
      "query",
      "limit"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "hit_count": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "chapter_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "beat_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "quote": {
              "type": "string"
            },
            "seq": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "chapter_id",
            "beat_id",
            "quote",
            "seq"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "hit_count",
      "items"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M0",
  "m0": true,
  "tool_id": "T19"
}
