{
  "name": "draft.get_chapter",
  "version": "1.0.0",
  "family": "knowledge",
  "summary": "按 revision 读取初稿正文；只读，revision 必须属于本项目当前章",
  "actors": [
    "reviewer"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [],
  "limits": {
    "timeout_ms": 800,
    "max_result_tokens": 2000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary",
    "facts_only",
    "empty"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "revision_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "required": [
      "revision_id"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "revision_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "chapter_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "kind": {
        "type": "string"
      },
      "content_hash": {
        "type": "string"
      },
      "beats": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "beat_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "speaker_type": {
              "type": "string"
            },
            "speaker_id": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          },
          "required": [
            "beat_id",
            "speaker_type",
            "speaker_id",
            "body"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "revision_id",
      "chapter_id",
      "kind",
      "content_hash",
      "beats"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M0",
  "m0": true,
  "tool_id": "T21"
}
