{
  "name": "storyboard.get_beat",
  "version": "1.0.0",
  "family": "structure",
  "summary": "返回本拍意图、字数上限与场景元信息，不给后续拍",
  "actors": [
    "character",
    "narrator"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [
    "beat_id"
  ],
  "limits": {
    "timeout_ms": 800,
    "max_result_tokens": 2000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary",
    "empty"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "beat_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "ord": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "intent": {
        "type": "string"
      },
      "max_words": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "scene": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "location": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "scene_id",
          "location",
          "goal",
          "participants"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "beat_id",
      "ord",
      "intent",
      "max_words",
      "scene"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M0",
  "m0": true,
  "tool_id": "T08"
}
