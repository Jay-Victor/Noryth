{
  "name": "foreshadow.list_open",
  "version": "1.1.0",
  "family": "knowledge",
  "summary": "列出未回收伏笔、埋设章与当前章距离，只报节奏，不报逻辑错误",
  "actors": [
    "orchestrator",
    "reviewer",
    "memory"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [],
  "limits": {
    "timeout_ms": 800,
    "max_result_tokens": 2000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary",
    "facts_only",
    "empty"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "chapter_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "as_of_chapter_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "as_of_ord": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "closed"
              ]
            },
            "planted_chapter_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "planted_chapter_ord": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "distance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "planned_payoff_chapter_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "overdue": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "text",
            "status",
            "planted_chapter_id",
            "planted_chapter_ord",
            "distance",
            "planned_payoff_chapter_id",
            "overdue",
            "note"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "as_of_chapter_id",
      "as_of_ord",
      "items"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "P1",
  "m0": false,
  "tool_id": "T22"
}
