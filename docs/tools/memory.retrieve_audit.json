{
  "name": "memory.retrieve_audit",
  "version": "1.0.0",
  "family": "knowledge",
  "summary": "审批按角色审计私有记忆，返回最小证据并标明用途 issue_ref",
  "actors": [
    "reviewer"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [
    "as_of"
  ],
  "limits": {
    "timeout_ms": 800,
    "max_result_tokens": 2000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary",
    "facts_only",
    "empty"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "character_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "top_k": {
        "default": 5,
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "issue_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "required": [
      "character_id",
      "query",
      "top_k",
      "issue_ref"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "hit_count": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "kind": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "learned_seq": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "importance": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "kind",
            "text",
            "learned_seq",
            "importance"
          ],
          "additionalProperties": false
        }
      },
      "issue_ref": {
        "type": "string"
      }
    },
    "required": [
      "hit_count",
      "items",
      "issue_ref"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M0",
  "m0": true,
  "tool_id": "T11"
}
