{
  "name": "storyboard.get_chapter",
  "version": "1.0.0",
  "family": "structure",
  "summary": "读取本章当前分镜：场景、拍、出口条件与拍状态",
  "actors": [
    "orchestrator",
    "reviewer"
  ],
  "side_effect": "none",
  "agent_callable": true,
  "requires_gate": null,
  "idempotency": "natural",
  "injected": [],
  "limits": {
    "timeout_ms": 800,
    "max_result_tokens": 2000,
    "max_calls_per_turn": 2
  },
  "degrade": [
    "full",
    "summary",
    "empty"
  ],
  "audit": {
    "log_args": "hash",
    "log_result_ids": true
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "chapter_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "required": [
      "chapter_id"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "chapter_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "status": {
        "type": "string"
      },
      "scenes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "scene_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "ord": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "location": {
              "type": "string"
            },
            "participants": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "goal": {
              "type": "string"
            },
            "entry": {
              "type": "string"
            },
            "exit": {},
            "status": {
              "type": "string"
            },
            "beats": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "beat_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "ord": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "speaker_type": {
                    "type": "string"
                  },
                  "speaker_id": {
                    "type": "string"
                  },
                  "intent": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "max_words": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "beat_id",
                  "ord",
                  "speaker_type",
                  "speaker_id",
                  "intent",
                  "status",
                  "max_words"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "scene_id",
            "ord",
            "location",
            "participants",
            "goal",
            "entry",
            "exit",
            "status",
            "beats"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "chapter_id",
      "status",
      "scenes"
    ],
    "additionalProperties": false
  },
  "contract_complete": true,
  "milestone": "M0",
  "m0": true,
  "tool_id": "T07"
}
