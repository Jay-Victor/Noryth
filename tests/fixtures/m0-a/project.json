  "chapters": [
    {
      "id": "ch_001",
      "ord": 1,
      "title": "祠堂夜谈",
      "scenes": [
        {
          "id": "scn_001_01",
          "ord": 1,
          "location": "沈家祠堂",
          "participants": [
            "chr_lin",
            "chr_shen"
          ],
          "goal": "确认黑漆匣子的下落",
          "entry": "雨夜，祠堂只剩一盏灯",
          "exit": {
            "resolved": false,
            "hook": "匣子底部刻着林家的记号"
          },
          "beats": [
            {
              "speakerType": "narrator",
              "speakerId": "narrator",
              "body": "她把茶盏往他那边推了推，窗外的雨还没有停。"
            },
            {
              "speakerType": "character",
              "speakerId": "chr_shen",
              "body": "「你在我爹书房里，见过一只黑漆匣子吗？」"
            },
            {
              "speakerType": "narrator",
              "speakerId": "narrator",
              "body": "他想起七年前那个同样潮湿的夜里，父亲把钥匙塞进他手心。"
            },
            {
              "speakerType": "character",
              "speakerId": "chr_lin",
              "body": "「见过。匣子不在书房，在祠堂的供桌下面。」"
            },
            {
              "speakerType": "narrator",
              "speakerId": "narrator",
              "body": "阿棠端着灯过来，灯芯爆了一下，墙上的人影跟着晃。"
            },
            {
              "speakerType": "character",
              "speakerId": "chr_shen",
              "body": "「老太爷吩咐过，供桌下面的东西谁也不能动。」"
            },
            {
              "speakerType": "narrator",
              "speakerId": "narrator",
              "body": "穆掌柜拨着算盘，珠子撞得很轻，像怕惊动谁。"
            },
            {
              "speakerType": "character",
              "speakerId": "chr_lin",
              "body": "「旧账翻篇容易，翻篇之后欠的人情，谁来还？」"
            }
          ]
        },
        {
          "id": "scn_001_02",
          "ord": 2,
          "location": "后巷茶摊",
          "participants": [
            "chr_lin",
            "chr_mu"
          ],
          "goal": "从穆掌柜嘴里撬出旧账",
          "entry": "茶摊收摊前最后一壶",
          "exit": {
            "resolved": false,
            "hook": "旧账最后一页被撕走"
          },
          "beats": [
            {
              "speakerType": "narrator",
              "speakerId": "narrator",
              "body": "雨声忽然大了，像有人在外头抖开一整匹布。"
            },
            {
              "speakerType": "character",
              "speakerId": "chr_mu",
              "body": "「我不欠沈家的人情，我欠的是我爹一个交代。」"
            },
            {
              "speakerType": "narrator",
              "speakerId": "narrator",
              "body": "她低头看见自己袖口沾了香灰，怎么掸也掸不掉。"
            },
            {
              "speakerType": "character",
              "speakerId": "chr_lin",
              "body": "「早夭的那个名字，族谱上没有，棺材里也没有。」"
            },
            {
              "speakerType": "narrator",
              "speakerId": "narrator",
              "body": "他把匣子翻过来，底部有一个被磨平的「林」字。"
            },
            {
              "speakerType": "character",
              "speakerId": "chr_mu",
              "body": "「这件事，明天天亮之前不要告诉第三个人。」"
            },
            {
              "speakerType": "narrator",
              "speakerId": "narrator",
              "body": "灯灭了。黑暗里只剩两个人的呼吸，一长一短。"
            },
            {
              "speakerType": "character",
              "speakerId": "chr_lin",
              "body": "「如果我不说，你能保证她活着走出这座宅子吗？」"
            }
          ]
        },
